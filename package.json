{
  "name": "lembrete-medicamentos",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de lembrete de medicamentos (TCC) — ver adr-001",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "build:css": "tailwindcss -i src/assets/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/assets/app.css -o public/css/app.css --watch",
    "build": "tsc -p tsconfig.build.json && npm run build:css",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/hbs": "^4.0.5",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "cheerio": "^1.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
