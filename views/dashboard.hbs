{{!--
  Tela inicial (Hoje) — PWA de lembrete de medicamentos.
  Padrão visual "Clean Health": bg-slate-50 / text-slate-800 / ação em teal-500..600.
  Arquitetura mobile-first: bottom nav < md, sidebar >= md.
--}}

<div class="min-h-screen bg-slate-50 text-slate-800 antialiased">

  {{!-- ==================== SIDEBAR (>= md) ==================== --}}
  <aside class="hidden md:flex md:flex-col w-64 h-screen fixed left-0 top-0 z-20 bg-white border-r border-slate-200">

    <div class="flex items-center gap-2.5 px-6 h-16 border-b border-slate-200">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-600">
        <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
          <path d="m8.5 8.5 7 7" />
        </svg>
      </span>
      <span class="text-base font-semibold tracking-tight text-slate-900">Lembrete</span>
    </div>

    <nav class="flex-1 px-3 py-4" aria-label="Navegação principal">
      <ul class="space-y-1">
        <li>
          <a href="/doses/hoje" aria-current="page"
             class="flex items-center gap-3 rounded-xl bg-teal-50 px-3 py-2.5 text-sm font-semibold text-teal-700">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /><path d="m9 16 2 2 4-4" />
            </svg>
            Hoje
          </a>
        </li>
        <li>
          <a href="/historico"
             class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" /><path d="M18.7 8 13 13.7l-3-3L7 14" />
            </svg>
            Histórico
          </a>
        </li>
      </ul>
    </nav>

    <div class="p-3 border-t border-slate-200">
      <a href="/medicamentos/novo"
         class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Adicionar remédio
      </a>
    </div>
  </aside>

  {{!-- ==================== CONTEÚDO ==================== --}}
  <main class="md:ml-64 px-4 pt-6 pb-32 md:px-8 md:pt-8 md:pb-10">

    <header class="mb-6 md:mb-8">
      <p class="text-sm font-medium capitalize text-slate-500">{{currentDate}}</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">
        Olá, {{user.name}}
      </h1>
    </header>

    <section aria-labelledby="doses-hoje">
      <h2 id="doses-hoje" class="sr-only">Doses de hoje</h2>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {{#each doses}}

          {{#if (eq status "PENDING")}}
            {{!-- ---------- Card pendente ---------- --}}
            <article class="flex flex-col rounded-2xl border-l-4 border-teal-500 bg-white p-5 shadow-sm">
              <div class="flex items-baseline justify-between gap-2">
                <time datetime="{{timeISO}}" class="text-3xl font-semibold tabular-nums tracking-tight text-slate-900">{{time}}</time>
                <span class="rounded-full bg-teal-50 px-2.5 py-1 text-xs font-medium text-teal-700">Pendente</span>
              </div>
              <h3 class="mt-3 text-base font-semibold text-slate-800">{{name}}</h3>
              <p class="mt-0.5 text-sm text-slate-500">{{dosage}}</p>

              <form method="post" action="/doses/{{id}}/taken" class="mt-5">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 active:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  Tomei
                </button>
              </form>

              <form method="post" action="/doses/{{id}}/skipped" class="mt-2">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button type="submit"
                        class="w-full rounded-lg px-4 py-2 text-xs font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-700">
                  Pular esta dose
                </button>
              </form>
            </article>

          {{else if (eq status "TAKEN")}}
            {{!-- ---------- Card tomado ---------- --}}
            <article class="flex flex-col rounded-2xl border-l-4 border-slate-300 bg-slate-100 p-5 opacity-60 shadow-sm">
              <div class="flex items-baseline justify-between gap-2">
                <time datetime="{{timeISO}}" class="text-3xl font-semibold tabular-nums tracking-tight text-slate-900">{{time}}</time>
                <span class="flex items-center gap-1.5 text-xs font-medium text-teal-600">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  Tomado
                </span>
              </div>
              <h3 class="mt-3 text-base font-semibold text-slate-800">{{name}}</h3>
              <p class="mt-0.5 text-sm text-slate-500">{{dosage}}</p>
            </article>

          {{else if (eq status "MISSED")}}
            {{!-- ---------- Card não registrado (janela de tolerância expirada) ---------- --}}
            <article class="flex flex-col rounded-2xl border-l-4 border-amber-400 bg-white p-5 shadow-sm">
              <div class="flex items-baseline justify-between gap-2">
                <time datetime="{{timeISO}}" class="text-3xl font-semibold tabular-nums tracking-tight text-slate-900">{{time}}</time>
                <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">Não registrado</span>
              </div>
              <h3 class="mt-3 text-base font-semibold text-slate-800">{{name}}</h3>
              <p class="mt-0.5 text-sm text-slate-500">{{dosage}}</p>
            </article>

          {{else}}
            {{!-- ---------- Card pulado ---------- --}}
            <article class="flex flex-col rounded-2xl border-l-4 border-slate-300 bg-slate-100 p-5 opacity-60 shadow-sm">
              <div class="flex items-baseline justify-between gap-2">
                <time datetime="{{timeISO}}" class="text-3xl font-semibold tabular-nums tracking-tight text-slate-900">{{time}}</time>
                <span class="rounded-full bg-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600">Pulado</span>
              </div>
              <h3 class="mt-3 text-base font-semibold text-slate-800">{{name}}</h3>
              <p class="mt-0.5 text-sm text-slate-500">{{dosage}}</p>
            </article>
          {{/if}}

        {{else}}
          {{!-- ---------- Estado vazio ---------- --}}
          <div class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
            <svg class="mx-auto h-10 w-10 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" />
            </svg>
            <h3 class="mt-4 text-base font-semibold text-slate-800">Nenhuma dose para hoje</h3>
            <p class="mx-auto mt-1 max-w-xs text-sm text-slate-500">
              Cadastre um medicamento para começar a receber os lembretes.
            </p>
            <a href="/medicamentos/novo"
               class="mt-5 inline-flex items-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700">
              Adicionar remédio
            </a>
          </div>
        {{/each}}
      </div>
    </section>
  </main>

  {{!-- ==================== BOTTOM NAV (< md) ==================== --}}
  <nav id="bottom-nav"
       class="fixed bottom-0 left-0 z-20 w-full border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] md:hidden"
       aria-label="Navegação principal">
    <ul class="grid grid-cols-3 items-end">
      <li>
        <a href="/doses/hoje" aria-current="page"
           class="flex flex-col items-center gap-1 px-2 py-3 text-teal-600">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /><path d="m9 16 2 2 4-4" />
          </svg>
          <span class="text-[11px] font-semibold">Hoje</span>
        </a>
      </li>

      <li class="flex justify-center">
        <a href="/medicamentos/novo" aria-label="Adicionar remédio"
           class="-mt-8 flex h-16 w-16 items-center justify-center rounded-full bg-teal-600 text-white shadow-lg shadow-teal-600/30 ring-4 ring-slate-50 transition hover:bg-teal-700 active:bg-teal-800">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </a>
      </li>

      <li>
        <a href="/historico"
           class="flex flex-col items-center gap-1 px-2 py-3 text-slate-400 transition hover:text-slate-600">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3v18h18" /><path d="M18.7 8 13 13.7l-3-3L7 14" />
          </svg>
          <span class="text-[11px] font-medium">Histórico</span>
        </a>
      </li>
    </ul>
  </nav>
</div>
