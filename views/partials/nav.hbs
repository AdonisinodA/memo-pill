{{!--
  Navegação do app: sidebar >= md, barra inferior < md.
  Parcial única para as três telas internas, invocada como
  {{> nav active="hoje"}} — assim um item novo aparece em todas de uma vez.
--}}

{{!-- ==================== SIDEBAR (>= md) ==================== --}}
<aside class="hidden md:flex md:flex-col w-64 h-screen fixed left-0 top-0 z-20 bg-white border-r border-slate-200">

  <div class="flex items-center gap-2.5 px-6 h-16 border-b border-slate-200">
    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-600">
      <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
        <path d="m8.5 8.5 7 7" />
      </svg>
    </span>
    <span class="text-base font-semibold tracking-tight text-slate-900">Lembrete</span>
  </div>

  <nav class="flex-1 px-3 py-4" aria-label="Navegação principal">
    <ul class="space-y-1">
      <li>
        <a href="/doses/hoje" {{#if (eq active "hoje")}}aria-current="page"{{/if}}
           class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm {{#if (eq active "hoje")}}bg-teal-50 font-semibold text-teal-700{{else}}font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900{{/if}}">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /><path d="m9 16 2 2 4-4" />
          </svg>
          Hoje
        </a>
      </li>
      <li>
        <a href="/medicamentos" {{#if (eq active "medicamentos")}}aria-current="page"{{/if}}
           class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm {{#if (eq active "medicamentos")}}bg-teal-50 font-semibold text-teal-700{{else}}font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900{{/if}}">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" />
          </svg>
          Remédios
        </a>
      </li>
      <li>
        <a href="/historico" {{#if (eq active "historico")}}aria-current="page"{{/if}}
           class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm {{#if (eq active "historico")}}bg-teal-50 font-semibold text-teal-700{{else}}font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900{{/if}}">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3v18h18" /><path d="M18.7 8 13 13.7l-3-3L7 14" />
          </svg>
          Histórico
        </a>
      </li>
    </ul>
  </nav>

  <div class="p-3 border-t border-slate-200">
    <a href="/medicamentos/novo"
       class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M12 5v14M5 12h14" />
      </svg>
      Adicionar remédio
    </a>

    <div class="mt-3 border-t border-slate-200 pt-3">
      {{#if user.name}}
        <p class="truncate px-1 pb-2 text-xs font-medium text-slate-500">{{user.name}}</p>
      {{/if}}
      {{> logout csrfToken=csrfToken}}
    </div>
  </div>
</aside>

{{!-- ==================== MENU DA CONTA (< md) ==================== --}}
{{!--
  <details> resolve o menu sem JavaScript: a CSP mantém script-src 'self' e
  não haveria onde pendurar um handler inline (ADR-001 §2.4).
--}}
<details id="account-menu" class="group fixed right-4 top-4 z-30 md:hidden">
  <summary aria-label="Conta"
           class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:text-slate-900 [&::-webkit-details-marker]:hidden">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
    </svg>
  </summary>

  <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-lg">
    {{#if user.name}}
      <p class="truncate px-1 pb-2 text-xs font-medium text-slate-500">{{user.name}}</p>
    {{/if}}
    {{> logout csrfToken=csrfToken}}
  </div>
</details>

{{!-- ==================== BOTTOM NAV (< md) ==================== --}}
<nav id="bottom-nav"
     class="fixed bottom-0 left-0 z-20 w-full border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] md:hidden"
     aria-label="Navegação principal">
  <ul class="grid grid-cols-4 items-end">
    <li>
      <a href="/doses/hoje" {{#if (eq active "hoje")}}aria-current="page"{{/if}}
         class="flex flex-col items-center gap-1 px-2 py-3 {{#if (eq active "hoje")}}text-teal-600{{else}}text-slate-400 transition hover:text-slate-600{{/if}}">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /><path d="m9 16 2 2 4-4" />
        </svg>
        <span class="text-[11px] {{#if (eq active "hoje")}}font-semibold{{else}}font-medium{{/if}}">Hoje</span>
      </a>
    </li>

    <li>
      <a href="/medicamentos" {{#if (eq active "medicamentos")}}aria-current="page"{{/if}}
         class="flex flex-col items-center gap-1 px-2 py-3 {{#if (eq active "medicamentos")}}text-teal-600{{else}}text-slate-400 transition hover:text-slate-600{{/if}}">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" />
        </svg>
        <span class="text-[11px] {{#if (eq active "medicamentos")}}font-semibold{{else}}font-medium{{/if}}">Remédios</span>
      </a>
    </li>

    <li class="flex justify-center">
      <a href="/medicamentos/novo" aria-label="Adicionar remédio"
         class="-mt-8 flex h-16 w-16 items-center justify-center rounded-full bg-teal-600 text-white shadow-lg shadow-teal-600/30 ring-4 ring-slate-50 transition hover:bg-teal-700 active:bg-teal-800">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </a>
    </li>

    <li>
      <a href="/historico" {{#if (eq active "historico")}}aria-current="page"{{/if}}
         class="flex flex-col items-center gap-1 px-2 py-3 {{#if (eq active "historico")}}text-teal-600{{else}}text-slate-400 transition hover:text-slate-600{{/if}}">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 3v18h18" /><path d="M18.7 8 13 13.7l-3-3L7 14" />
        </svg>
        <span class="text-[11px] {{#if (eq active "historico")}}font-semibold{{else}}font-medium{{/if}}">Histórico</span>
      </a>
    </li>
  </ul>
</nav>
