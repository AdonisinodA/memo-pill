{{!--
  Remédios cadastrados. Mostra a posologia inteira — horários, período e
  situação —, que é o que falta ao dashboard: lá só aparecem as doses de hoje,
  então um tratamento que ainda não começou ou já terminou não deixa rastro.
--}}

<div class="min-h-screen bg-slate-50 text-slate-800 antialiased">

  {{> nav active="medicamentos"}}

  <main class="md:ml-64 px-4 pt-6 pb-32 md:px-8 md:pt-8 md:pb-10">

    <header class="mb-6 flex items-start justify-between gap-4 md:mb-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl">Meus remédios</h1>
        <p class="mt-1 text-sm text-slate-500">
          {{#if medications.length}}{{medications.length}} cadastrado{{#unless (eq medications.length 1)}}s{{/unless}}{{else}}Nenhum cadastro ainda{{/if}}
        </p>
      </div>

      <a href="/medicamentos/novo"
         class="hidden shrink-0 items-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 md:inline-flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Adicionar
      </a>
    </header>

    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {{#each medications}}
        <li class="flex flex-col rounded-2xl border-l-4 bg-white p-5 shadow-sm
                   {{#if (eq status "ACTIVE")}}border-teal-500{{else if (eq status "SCHEDULED")}}border-sky-400{{else}}border-slate-300{{/if}}">

          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="truncate text-base font-semibold text-slate-800">{{name}}</h2>
              <p class="mt-0.5 text-sm text-slate-500">{{dosage}}</p>
            </div>

            {{#if (eq status "ACTIVE")}}
              <span class="shrink-0 rounded-full bg-teal-50 px-2.5 py-1 text-xs font-medium text-teal-700">Em uso</span>
            {{else if (eq status "SCHEDULED")}}
              <span class="shrink-0 rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-700">A começar</span>
            {{else}}
              <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">Encerrado</span>
            {{/if}}
          </div>

          <div class="mt-4">
            <p class="text-xs font-medium text-slate-500">
              {{times.length}}x ao dia
            </p>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {{#each times}}
                <li class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-semibold tabular-nums text-slate-700">{{this}}</li>
              {{/each}}
            </ul>
          </div>

          <dl class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
            <div class="flex justify-between gap-2">
              <dt>Início</dt>
              <dd class="tabular-nums text-slate-700">{{date startsOn}}</dd>
            </div>
            <div class="mt-1 flex justify-between gap-2">
              <dt>Fim</dt>
              <dd class="{{#if endsOn}}tabular-nums {{/if}}text-slate-700">{{#if endsOn}}{{date endsOn}}{{else}}uso contínuo{{/if}}</dd>
            </div>
          </dl>

          <form method="post" action="/medicamentos/{{id}}/remover" class="mt-4">
            <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
            <button type="submit"
                    class="w-full rounded-lg px-4 py-2 text-xs font-medium text-slate-500 transition hover:bg-red-50 hover:text-red-700">
              Remover
            </button>
          </form>
        </li>
      {{else}}
        <li class="col-span-full rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
          <svg class="mx-auto h-10 w-10 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" />
          </svg>
          <h2 class="mt-4 text-base font-semibold text-slate-800">Nenhum remédio cadastrado</h2>
          <p class="mx-auto mt-1 max-w-xs text-sm text-slate-500">
            Cadastre o primeiro para que os lembretes comecem a ser gerados.
          </p>
          <a href="/medicamentos/novo"
             class="mt-5 inline-flex items-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700">
            Adicionar remédio
          </a>
        </li>
      {{/each}}
    </ul>
  </main>
</div>
